{
  "name": "sift",
  "version": "0.1.0",
  "description": "A self-hosted, LLM-free, infinitely scrolling feed of articles and practice cards you configure. Cloudflare Worker + D1, with a small fetcher.",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:d1": "node --test --test-concurrency=1 test/worker.test.js test/runner.test.js",
    "runner": "node runner/run.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "fast-xml-parser": "5.11.2",
    "linkedom": "0.18.15",
    "bee-kit": "github:samjmerrick/bee-kit"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.118.0"
  }
}
