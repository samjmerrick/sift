{
  "name": "sift",
  "version": "0.1.0",
  "description": "A self-hosted, LLM-free, infinitely scrolling feed of articles and practice cards you configure. Supabase + GitHub Pages.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "fetch": "node scripts/fetch.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "preview": "node scripts/build-preview.js",
    "bee:fetch": "node bee/fetch.js",
    "bee:import": "node bee/import-supabase.js",
    "bee:server": "node bee/server.js",
    "test:d1": "node --test --test-concurrency=1 test/worker.test.js test/runner.test.js",
    "runner": "node runner/run.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@mozilla/readability": "0.6.0",
    "fast-xml-parser": "5.11.2",
    "linkedom": "0.18.15",
    "postgres": "3.4.9",
    "bee-kit": "github:samjmerrick/bee-kit"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.118.0",
    "esbuild": "^0.24.0"
  }
}
